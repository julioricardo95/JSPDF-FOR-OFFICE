<div class="form-group">
  <label for="nombre_completo" class="form-label">Nombre Completo</label>
  <input
    type="text"
    id="nombre_completo"
    name="nombre_completo"
    class="form-input"
    placeholder="Nombre Completo"
    value="N/A"
  />
</div>

<div class="form-group">
  <label for="cedula" class="form-label">Cedula o Pasaporte</label>
