---
import DatosPropietario from "./DatosPropietario.astro";
import DatosEncuesta from "./DatosEncuesta.astro";
import FichaForm from "./FichaForm.astro";
---

<FichaForm ficha={6}>
  <div class="form-group">
      <label for="codigo_catastral" class="form-label">Codigo catastral</label>
      <input type="number" id="codigo_catastral" name="codigo_catastral" class="form-input" placeholder="Codigo catastral" required />
  </div>
  <div class="form-group">
      <label for="SISCAT" class="form-label">SISCAT</label>
      <input type="number" id="SISCAT" name="SISCAT" class="form-input" placeholder="SISCAT" />
  </div>
  <div class="form-group">
      <label for="propietarios" class="form-label">Tipo de Propietario</label>
      <select id="propietarios" name="propietarios" class="form-select">
          <option value="Propietario">Propietario</option>
          <option value="Poseedor">Poseedor</option>
          <option value="Personeria">Personeria</option>
      </select>
  </div>
  <DatosPropietario />
  <div class="form-group">
      <label for="beneficios" class="form-label">Beneficios</label>
      <input type="text" id="beneficios" name="beneficios" class="form-input" placeholder="Beneficios" value="N/A" />
  </div>
  <div class="form-group">
      <label for="nececidades" class="form-label">Nececidades de la Poblacion</label>
      <select id="nececidades" name="nececidades" class="form-select">
          <option value="otro">Otro</option>
          <option value="lim">S.R. Lim</option>
          <option value="coop">S. Coop</option>
          <option value="anonima">S. Anonima</option>
      </select>
  </div>
  <DatosEncuesta />

  <fieldset>
    <legend>Choose your interests</legend>

    <div class="form-group">
      <input
        type="checkbox"
        id="agua"
        name="servicios"
        value="AGUA POTABLE"
        class="form-input"
      />
      <label for="agua" class="form-label">AGUA POTABLE</label>
    </div>
    <div class="form-group">
      <input
        type="checkbox"
        id="alc_pluvial"
        name="servicios"
        value="ALCANTARILLADO PLUVIAL"
        class="form-input"
      />
      <label for="alc_pluvial" class="form-label">ALCANTARILLADO PLUVIAL</label>
    </div>
    <div class="form-group">
      <input
        type="checkbox"
        id="energia"
        name="servicios"
        value="ENERGIA ELECTRICA"
        class="form-input"
      />
      <label for="energia" class="form-label">ENERGIA ELECTRICA</label>
    </div>
    
  </fieldset>

  <slot />
</FichaForm>